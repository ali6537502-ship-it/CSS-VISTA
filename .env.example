# CSS Vista - Supabase (optional; site works in guest mode without these)
# Create a Supabase project, run supabase/migrations/*.sql in filename order,
# then copy the Project URL and browser-safe Publishable key from Connect.
# Never use an sb_secret_ or legacy service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enable only after Google is configured in Supabase Auth and the production
# /account callback URL has been added to the Auth redirect allowlist.
VITE_SUPABASE_GOOGLE_AUTH_ENABLED=false

# Optional Google AdSense manual responsive in-content unit. Auto Ads uses the
# publisher ID fixed in source and does not need a slot ID. Leave this empty
# until the owner creates a real display unit in AdSense; never invent an ID.
VITE_ADSENSE_SLOT_CONTENT=
