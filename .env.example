# CSS Vista — Supabase (optional; site works in guest mode without these)
# Create a Supabase project, run supabase/migrations/*.sql in order, then fill these in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Google AdSense manual responsive display unit.
# Publisher ID is fixed in source; use the numeric slot ID created in AdSense.
VITE_ADSENSE_SLOT_CONTENT=replace-with-your-numeric-ad-unit-slot-id
