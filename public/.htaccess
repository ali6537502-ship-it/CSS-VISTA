DirectoryIndex index.html
ErrorDocument 404 /404.html

# Never allow the private runtime configuration to be downloaded over HTTP.
# PHP can still include this file internally when present in the document root.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</Files>

# One-time bootstrap schema payloads are server-readable only.
<FilesMatch "^_bootstrap_schema\.(?:sql|txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Keep Google ownership, crawler-control and advertising verification endpoints
# as literal public files. These rules run before application routing so search
# engines always receive the requested resource instead of an HTML shell.
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
  AddType application/vnd.openxmlformats-officedocument.wordprocessingml.document .docx
</IfModule>

# Prefer Brotli for compressible text responses when the host supports it.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>

# Vite production files under /assets/ use content-hashed filenames, so they can
# be cached immutably. Other public images/fonts/data use shorter safe lifetimes.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/" cssv_hashed_asset=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Public generated HTML is short-lived and revalidated. The SPA shell and
  # service-worker recovery files below deliberately override this with no-store.
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|gif|webp|svg|ico)$">
    Header always set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|ttf)$">
    Header always set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(?:index\.html|sw\.js|stale-module\.js)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  <FilesMatch "^sitemap(?:-[A-Za-z0-9-]+)?\.xml$">
    Header always set Content-Type "application/xml; charset=UTF-8"
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <Files "ads.txt">
    Header always set Content-Type "text/plain; charset=UTF-8"
    Header always set Cache-Control "public, max-age=300, must-revalidate"
    Header always set X-Content-Type-Options "nosniff"
  </Files>
  <Files "googlec96e2248070e0570.html">
    Header always set Cache-Control "public, max-age=300, must-revalidate"
    Header always set X-Content-Type-Options "nosniff"
  </Files>

  Header always set Cache-Control "public, max-age=31536000, immutable" env=cssv_hashed_asset
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Consolidate every protocol and hostname variant on the canonical origin.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.css-vista\.com$ [NC]
  RewriteRule ^ https://www.css-vista.com%{REQUEST_URI} [R=301,L,NE]

  # Consolidate the retired generic privacy URL onto the canonical policy URL.
  RewriteRule ^privacy/?$ https://www.css-vista.com/privacy-policy [R=301,L,NE]

  # Block private runtime config/storage and bootstrap schema from direct web access.
  RewriteRule ^config\.php$ - [F,L,NC]
  RewriteRule ^storage(?:/|$) - [F,L,NC]
  RewriteRule ^api/_bootstrap_schema\.(?:sql|txt)$ - [F,L,NC]

  # Never rewrite crawler-control and verification files into the React app.
  # This explicitly covers the sitemap index and every generated child sitemap.
  RewriteRule ^(?:ads\.txt|robots\.txt|sitemap(?:-[A-Za-z0-9-]+)?\.xml|googlec96e2248070e0570\.html)$ - [L,NC]

  # An already-open tab may ask for a page module from the preceding release.
  # Serve a tiny recovery module at that obsolete JavaScript URL so even the
  # old application refreshes itself without showing a broken-page screen.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/.*\.js$ stale-module.js [L,NC]

  # Other removed static assets must return a real error. Never send index.html
  # with a CSS, JSON, font or image URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule \.(?:js|mjs|css|json|map|woff2?|ttf|png|jpe?g|gif|svg|webp|ico)$ - [R=404,L,NC]

  # CSSV_GENERATED_ROUTE_RULES_START
  # Exact application routes are inserted here by the production build.
  # CSSV_GENERATED_ROUTE_RULES_END

  # Serve the generated search-friendly past-paper pages at their public URLs.
  RewriteRule ^css-2026-written-result/?$ seo/css-2026-written-result.html [L]
  RewriteRule ^past-papers/view/([A-Za-z0-9-]+)/?$ seo/past-papers/$1.html [L]
  RewriteRule ^past-papers/(css|pms|ppsc|mpt)/([0-9]{4})/?$ seo/past-paper-collections/$1/$2.html [L]
  RewriteRule ^(?:notes/view/[^/]+/[^/]+|mpt/bank/[^/]+|gk/cat/[^/]+)/?$ seo/routes/protected.html [L,NC]

  # Keep real files and directories intact. Unknown clean URLs deliberately
  # return 404 instead of the SPA shell, preventing Search Console soft 404s.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ - [R=404,L]
</IfModule>
