{
  "title": "CSS English (Precis and Composition) Library",
  "marks": 100,
  "official_source": "https://www.fpsc.gov.pk/uploads/syllabus/1767002683737_Syllabus-for-CE-2016-and-onwards.pdf",
  "verified_on": "2026-07-16",
  "components": [
    {
      "order": 1,
      "name": "Precis Writing",
      "marks": 20,
      "official_description": "A selected passage is given for precis writing and an appropriate title; 15 marks are allocated to the precis and 5 to the title."
    },
    {
      "order": 2,
      "name": "Reading Comprehension",
      "marks": 20,
      "official_description": "A substantive, non-technical passage is followed by five questions of four marks each."
    },
    {
      "order": 3,
      "name": "Grammar and Vocabulary",
      "marks": 20,
      "topics": [
        "Tenses",
        "Articles",
        "Prepositions",
        "Conjunctions",
        "Punctuation",
        "Phrasal verbs",
        "Synonyms",
        "Antonyms"
      ]
    },
    {
      "order": 4,
      "name": "Sentence Correction",
      "marks": 10,
      "official_description": "Structurally or punctuationally flawed sentences are rewritten with only the necessary corrections."
    },
    {
      "order": 5,
      "name": "Grouping of Words",
      "marks": 10,
      "official_description": "Twenty words are grouped into pairs with similar or opposite meanings, as directed."
    },
    {
      "order": 6,
      "name": "Pairs of Words",
      "marks": 10,
      "official_description": "Ten commonly confused pairs are given; candidates explain and use any five pairs in sentences."
    },
    {
      "order": 7,
      "name": "Translation",
      "marks": 10,
      "official_description": "Ten Urdu sentences involving structure and idiomatic expression are translated into English."
    }
  ],
  "suggested_readings_from_official_syllabus": [
    {
      "title": "English Grammar in Use",
      "author": "Raymond Murphy"
    },
    {
      "title": "Practical English Usage",
      "author": "Michael Swan"
    },
    {
      "title": "The Little, Brown Handbook",
      "author": "H. Ramsey Fowler and Jane E. Aaron"
    },
    {
      "title": "A University Grammar of English",
      "author": "Randolph Quirk and Sidney Greenbaum"
    },
    {
      "title": "Write Better, Speak Better",
      "author": "Reader's Digest Association"
    },
    {
      "title": "Modern English in Action",
      "author": "Henry I. Christ"
    }
  ],
