# CSS Vista — Hostinger production environment template
# Add these values in Hostinger's build-time Environment Variables panel.
# Do not commit real secrets. Only browser-safe VITE_ values belong here.

SITE_ORIGIN=https://www.css-vista.com
CSSV_STRICT_CONTENT_VALIDATION=false


# Optional AdSense manual in-content unit. Leave blank until a real unit exists.
VITE_ADSENSE_SLOT_CONTENT=
